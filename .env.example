# Local development defaults to the built-in MSW-powered API mocks.
NEXT_PUBLIC_API_URL='mock'
NEXT_PUBLIC_API_MOCKING='true'

# To use the real backend locally, set both values below and use a tenant that
# is safe for development. Production and Vercel Preview values are documented
# in docs/VERCEL_DEPLOYMENT.md; do not commit those values here.
# NEXT_PUBLIC_API_URL='http://localhost:8080/api/v1'
# NEXT_PUBLIC_API_MOCKING='false'
NEXT_PUBLIC_TENANT_ID=''

NEXT_PUBLIC_APP_NAME='toko'
NEXT_PUBLIC_SITE_URL='http://localhost:3000'

# Media/CDN origin used by Next/Image's remote-host configuration. It is not
# an API runtime URL.
NEXT_PUBLIC_CDN_URL='http://localhost:3000/cdn'

# Optional telemetry. Empty keys and RUM disabled are safe local defaults.
NEXT_PUBLIC_POSTHOG_KEY=''
NEXT_PUBLIC_POSTHOG_HOST='https://us.i.posthog.com'
NEXT_PUBLIC_SENTRY_DSN=''
NEXT_PUBLIC_RUM_DEST='none'
NEXT_PUBLIC_RUM_SAMPLE='0'
