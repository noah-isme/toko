{
  "name": "toko",
  "version": "1.0.0",
  "description": "Modular Next.js storefront frontend for the Toko e-commerce platform.",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:e2e": "NEXT_PUBLIC_API_MOCKING=true NEXT_PUBLIC_API_URL=mock next dev",
    "dev:real-api": "NEXT_PUBLIC_API_MOCKING=false NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1 next dev",
    "build": "next build",
    "build:mock": "NEXT_PUBLIC_API_URL=mock NEXT_PUBLIC_API_MOCKING=false next build",
    "start": "next start",
    "start:mock": "NEXT_PUBLIC_API_URL=mock NEXT_PUBLIC_API_MOCKING=false next start",
    "lint": "eslint . && node scripts/i18n/check-messages.mjs",
    "i18n:check": "node scripts/i18n/check-messages.mjs",
    "lint:docs": "node scripts/docs/check-links.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json",
    "api:sync": "cp ../toko-api/openapi.yaml openapi.yaml",
    "api:generate": "openapi-typescript openapi.yaml -o src/lib/api/generated/schema.d.ts",
    "api:check": "pnpm api:generate && git diff --exit-code --stat src/lib/api/generated/schema.d.ts",
    "deployment:validate": "node scripts/validate-deployment-env.mjs",
    "test": "vitest run",
    "test:ci": "vitest run --reporter=dot --pool=forks --maxWorkers=2",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "e2e": "NEXT_PUBLIC_API_MOCKING=true NEXT_PUBLIC_API_URL=mock playwright test --project=chromium --reporter=line",
    "e2e:prod": "playwright test -c playwright.prod.config.ts --reporter=line",
    "e2e:visual": "playwright test --project=chromium-visual --reporter=line",
    "e2e:real-api": "playwright test -c playwright.real-api.config.ts --project=chromium-real-api --reporter=line",
    "e2e:visual:real-api": "playwright test -c playwright.real-api.config.ts --project=chromium-real-api --reporter=line",
    "e2e:visual:real-api:config": "playwright test -c playwright.real-api.config.ts --reporter=line",
    "e2e:visual:real-api:run": "bash scripts/run-visual-real-api-tests.sh",
    "e2e:mobile": "playwright test --project=mobile-chrome-visual --reporter=line",
    "e2e:tablet": "playwright test --project=tablet-visual --reporter=line",
    "analyze": "next experimental-analyze --output",
    "format": "prettier --write .",
    "lint-staged": "lint-staged",
    "prepare": "husky install"
  },
  "keywords": [
    "nextjs",
    "ecommerce",
    "frontend"
  ],
  "author": "",
  "license": "MIT",
  "packageManager": "pnpm@10.5.2",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": "10.5.2"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@sentry/nextjs": "^10.27.0",
    "@serwist/turbopack": "^9.5.12",
    "@tanstack/react-query": "^5.90.5",
    "@tanstack/react-query-devtools": "^5.90.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "leaflet": "^1.9.4",
    "leaflet-defaulticon-compatibility": "^0.1.2",
    "lucide-react": "^0.548.0",
    "next": "16.3.3",
    "next-intl": "^4.14.9",
    "posthog-js": "^1.281.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.65.0",
    "react-leaflet": "^5.0.0",
    "server-only": "^0.0.1",
    "serwist": "^9.5.12",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "1.0.7",
    "web-vitals": "^4.2.4",
    "zod": "^4.1.12",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@eslint/compat": "2.1.0",
    "@faker-js/faker": "10.6.0",
    "@playwright/test": "^1.56.1",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^22",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "3.2.6",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "eslint": "10.9.1",
    "eslint-config-next": "16.3.3",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-tailwindcss": "3.17.5",
    "globals": "^17.13.0",
    "husky": "9.1.6",
    "jsdom": "28.1.0",
    "lint-staged": "15.2.10",
    "msw": "2.6.2",
    "openapi-typescript": "7",
    "postcss": "^8.5.18",
    "prettier": "3.3.3",
    "tailwindcss": "^3.4.14",
    "typescript": "5.6.3",
    "typescript-eslint": "8.68.0",
    "vite": "6.4.3",
    "vitest": "3.2.6"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "pnpm exec eslint --fix"
    ],
    "*.{ts,tsx,js,jsx,json,css,md,mdx}": [
      "pnpm exec prettier --write"
    ]
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
